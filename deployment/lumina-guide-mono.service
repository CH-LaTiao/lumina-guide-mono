[Unit]
Description=LUMINA Guide Mono
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/lumina-guide-mono
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/lumina-guide-mono/run.sh --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
KillMode=mixed
UMask=0077

[Install]
WantedBy=multi-user.target
